# Replicates the routing of Appwrite 2.x's stock Traefik: the API owns /v1 and
# /.well-known, realtime owns /v1/realtime, the console serves everything else.
# Upstream hostnames are variables so nginx resolves them lazily via Railway's
# private DNS instead of crashing if a sibling service isn't up yet.
server {
    listen ${PORT};
    listen [::]:${PORT};

    # Appwrite's API and realtime servers bind 0.0.0.0 only; skip the AAAA
    # record so every request doesn't first hit a refused IPv6 connect.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    client_max_body_size 64m;

    set $realtime http://${REALTIME_HOST};
    set $console  http://${CONSOLE_HOST};
    set $appwrite http://${APPWRITE_HOST};

    # Railway healthcheck target: probes arrive with Host: healthcheck.railway.app,
    # which Appwrite's router protection would 401 — answer locally instead.
    location = /health {
        return 200 'ok';
        default_type text/plain;
    }

    location /v1/realtime {
        proxy_pass $realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /v1 {
        proxy_pass $appwrite;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location /.well-known {
        proxy_pass $appwrite;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass $console;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
