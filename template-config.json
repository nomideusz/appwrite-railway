   "name": "gateway",
   "icon": "https://appwrite.io/assets/logomark/logo.svg",
   "source": {
    "repo": "https://github.com/nomideusz/appwrite-railway",
    "rootDirectory": "/gateway"
   },
   "build": {},
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "variables": {
    "PUBLIC_HOST": {
     "defaultValue": "${{RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Public domain of your Appwrite. Every service reads it. Using a custom domain? Put it here.",
     "isOptional": false
    },
    "APPWRITE_HOST": {
     "defaultValue": "${{appwrite.RAILWAY_PRIVATE_DOMAIN}}:${{appwrite.PORT}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "REALTIME_HOST": {
     "defaultValue": "${{realtime.RAILWAY_PRIVATE_DOMAIN}}:${{realtime.PORT}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "CONSOLE_HOST": {
     "defaultValue": "${{console.RAILWAY_PRIVATE_DOMAIN}}:${{console.PORT}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    }
   },
   "volumeMounts": null,
   "networking": {
    "serviceDomains": {
     "<hasDomain>": {}
    }
   }
  },
  "0552a01e-6ac4-49cb-b0fe-8fb9fa8699a5": {
   "name": "appwrite",
   "icon": "https://appwrite.io/assets/logomark/logo.svg",
   "source": {
    "repo": "https://github.com/nomideusz/appwrite-railway",
    "rootDirectory": "/appwrite"
   },
   "build": {},
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/v1/health/version",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckTimeout": 300
   },
   "variables": {
    "PORT": {
     "defaultValue": "80",
     "description": "Port the API listens on. Don't change.",
     "isOptional": false
    },
    "_APP_OPENSSL_KEY_V1": {
     "defaultValue": "${{secret(64, \"abcdef0123456789\")}}",
     "description": "Encryption key for secrets and sessions. Auto-generated. Never change it after deploy: encrypted data becomes unreadable.",
     "isOptional": false
    },
    "_APP_DB_HOST": {
     "defaultValue": "${{postgresql.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_DB_PASS": {
     "defaultValue": "${{postgresql.POSTGRES_PASSWORD}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_REDIS_HOST": {
     "defaultValue": "${{redis.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_DOMAIN": {
     "defaultValue": "${{gateway.PUBLIC_HOST}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_CONSOLE_DOMAIN": {
     "defaultValue": "${{gateway.PUBLIC_HOST}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_CONSOLE_HOSTNAMES": {
     "defaultValue": "${{gateway.PUBLIC_HOST}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_DOMAIN_TARGET_CNAME": {
     "defaultValue": "${{gateway.PUBLIC_HOST}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_DB_HOST_VECTORSDB": {
     "defaultValue": "${{postgresql.RAILWAY_PRIVATE_DOMAIN}}",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_CONNECTIONS_DB_USAGE": {
     "defaultValue": "http://appwrite:${{clickhouse.CLICKHOUSE_PASSWORD}}@${{clickhouse.RAILWAY_PRIVATE_DOMAIN}}:8123/appwrite",
     "description": "Wired automatically. Don't change.",
     "isOptional": false
    },
    "_APP_STORAGE_S3_ACCESS_KEY": {
     "defaultValue": "${{storage.ACCESS_KEY_ID}}",
     "description": "Railway bucket credentials. Don't change.",
     "isOptional": false
    },
    "_APP_STORAGE_S3_SECRET": {
     "defaultValue": "${{storage.SECRET_ACCESS_KEY}}",
     "description": "Railway bucket credentials. Don't change.",
     "isOptional": false
    },
    "_APP_STORAGE_S3_REGION": {
     "defaultValue": "${{storage.REGION}}",
     "description": "Railway bucket credentials. Don't change.",
     "isOptional": false
    },
    "_APP_STORAGE_S3_BUCKET": {
     "defaultValue": "${{storage.BUCKET}}",
     "description": "Railway bucket credentials. Don't change.",
     "isOptional": false
    },
    "_APP_STORAGE_S3_ENDPOINT": {
     "defaultValue": "${{storage.ENDPOINT}}",
     "description": "Railway bucket credentials. Don't change.",
     "isOptional": false
    },
    "_APP_SMTP_HOST": {
     "defaultValue": "",
     "description": "Optional: SMTP host for signup verification, password recovery and invites. Railway's Hobby plan blocks ports 25/465/587, so use a provider port like 2525 (Mailgun, SendGrid) or 2587 (Resend).",
     "isOptional": true
    },
    "_APP_SMTP_PORT": {
     "defaultValue": "2525",
     "description": "Optional: SMTP port.",
     "isOptional": true
    },
    "_APP_SMTP_SECURE": {
     "defaultValue": "tls",
     "description": "Optional: tls, ssl, or empty for none.",
     "isOptional": true
    },
    "_APP_SMTP_USERNAME": {
     "defaultValue": "",
     "description": "Optional: SMTP username.",
     "isOptional": true
    },
    "_APP_SMTP_PASSWORD": {
     "defaultValue": "",
     "description": "Optional: SMTP password.",
     "isOptional": true
    },
    "_APP_SYSTEM_EMAIL_ADDRESS": {
     "defaultValue": "",
     "description": "Optional: sender address for Appwrite emails (must be allowed by your SMTP provider).",
     "isOptional": true
    }
   },
   "volumeMounts": null,
   "networking": {
    "serviceDomains": {}
   }
  },
